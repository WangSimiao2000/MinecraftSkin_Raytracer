#version 460
#extension GL_EXT_ray_tracing : require

// ── Descriptor bindings ─────────────────────────────────────────────────────

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba8) uniform image2D outputImage;

layout(set = 0, binding = 2) uniform RenderUniforms {
    // Camera
    mat4 cameraInverseView;
    mat4 cameraInverseProj;
    vec3 cameraPosition;
    float fov;

    // Light
    vec3 lightPosition;
    float lightRadius;
    vec3 lightColor;
    float lightIntensity;

    // Render parameters
    int samplesPerPixel;
    int maxBounces;
    int shadowSamples;
    int aoSamples;

    // Effect toggles & parameters
    int softShadows;
    int aoEnabled;
    float aoRadius;
    float aoIntensity;
    int dofEnabled;
    float aperture;
    float focusDistance;

    // Background
    int gradientBg;
    float gradientScale;
    vec3 bgCenter;
    vec3 bgEdge;

    // Image dimensions
    int width;
    int height;
} uniforms;

// ── Ray payload ─────────────────────────────────────────────────────────────

layout(location = 0) rayPayloadEXT vec3 payloadColor;

// ── PCG hash for random number generation ───────────────────────────────────

uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// Returns a float in [0, 1) from a seed; advances the seed.
float randomFloat(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) / 4294967296.0;
}

// ── Concentric disk sampling (uniform) ──────────────────────────────────────

vec2 sampleDisk(inout uint seed) {
    float u = randomFloat(seed);
    float v = randomFloat(seed);
    float angle = 2.0 * 3.14159265358979 * u;
    float radius = sqrt(v);
    return vec2(cos(angle), sin(angle)) * radius;
}

// ── Main ────────────────────────────────────────────────────────────────────

void main() {
    const ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    const ivec2 launchSize = ivec2(gl_LaunchSizeEXT.xy);

    int spp = max(1, uniforms.samplesPerPixel);

    // Initialise RNG seed from pixel coordinates
    uint seed = pcgHash(uint(pixelCoord.y * launchSize.x + pixelCoord.x));

    vec3 accumulated = vec3(0.0);

    for (int s = 0; s < spp; ++s) {
        // Mix sample index into seed for per-sample variation
        seed = pcgHash(seed + uint(s));

        // Sub-pixel jitter for anti-aliasing
        float jx = (spp == 1) ? 0.5 : randomFloat(seed);
        float jy = (spp == 1) ? 0.5 : randomFloat(seed);

        // Normalised device coordinates in [-1, 1]
        float u = (float(pixelCoord.x) + jx) / float(launchSize.x);
        float v = (float(pixelCoord.y) + jy) / float(launchSize.y);
        vec2 ndc = vec2(u, v) * 2.0 - 1.0;

        // Unproject through inverse projection → view-space direction
        vec4 clipTarget = vec4(ndc.x, ndc.y, 1.0, 1.0);
        vec4 viewTarget = uniforms.cameraInverseProj * clipTarget;
        viewTarget /= viewTarget.w;

        // Transform to world space via inverse view matrix
        vec3 worldDir = normalize((uniforms.cameraInverseView * vec4(viewTarget.xyz, 0.0)).xyz);
        vec3 origin   = uniforms.cameraPosition;

        // Depth of field (thin-lens model)
        if (uniforms.dofEnabled != 0 && uniforms.aperture > 1e-6) {
            // Compute focus point along the pinhole ray
            float focusDist = uniforms.focusDistance;
            if (focusDist <= 0.0) {
                // Auto-focus: use a reasonable default distance
                focusDist = 10.0;
            }
            vec3 focusPoint = origin + worldDir * focusDist;

            // Jitter origin on the lens disk
            vec2 lensSample = sampleDisk(seed) * uniforms.aperture;

            // Camera basis vectors from inverse view matrix columns
            vec3 camRight = normalize(uniforms.cameraInverseView[0].xyz);
            vec3 camUp    = normalize(uniforms.cameraInverseView[1].xyz);

            origin   = origin + camRight * lensSample.x + camUp * lensSample.y;
            worldDir = normalize(focusPoint - origin);
        }

        // Trace ray
        float tMin = 0.001;
        float tMax = 10000.0;

        payloadColor = vec3(0.0);

        traceRayEXT(
            topLevelAS,       // acceleration structure
            gl_RayFlagsOpaqueEXT, // ray flags
            0xFF,             // cull mask
            0,                // SBT record offset (hit group index)
            0,                // SBT record stride
            0,                // miss shader index
            origin,           // ray origin
            tMin,             // minimum t
            worldDir,         // ray direction
            tMax,             // maximum t
            0                 // payload location
        );

        accumulated += payloadColor;
    }

    // Average samples and store
    vec3 color = accumulated / float(spp);
    imageStore(outputImage, pixelCoord, vec4(color, 1.0));
}
